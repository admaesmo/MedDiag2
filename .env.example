DATABASE_URL=sqlite:///./meddiag.local.db
MODEL_DIR=./saved_models
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
AUTH_PROVIDER=local
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Supabase (only if AUTH_PROVIDER=supabase)
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_JWKS_URL=

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/audio

# Audio
MAX_AUDIO_FILE_SIZE_MB=25

# Optional PostgreSQL local profile:
# DATABASE_URL=postgresql+psycopg2://meddiag:meddiag@localhost:5432/meddiag
